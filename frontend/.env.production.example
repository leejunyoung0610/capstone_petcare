# 같은 도메인 nginx 프록시 사용 시 비워두면 /api 상대 경로 (권장)
# VITE_API_URL=

# AI 서버는 외부에 노출하지 않음 — 프론트는 /api(백엔드)만 호출

# 카카오 개발자 콘솔 JavaScript 키
VITE_KAKAO_MAP_KEY=
