# Backend API URL
# ── 휴대폰이 같은 Wi-Fi 에서 http://PC_IP:5173 으로 접속하는 경우 ──
#   VITE_API_URL 을 비우거나 주석 처리하세요. (상대 경로 /api → Vite 프록시 → 백엔드)
#   localhost 로 두면 폰 브라우저에서 localhost = 폰 자신 이라 API 가 깨집니다.
#   (코드가 LAN 접속 시 루프백 URL 을 자동으로 무시하기도 하지만, 비우는 것을 권장)
# VITE_API_URL=http://localhost:8001/api

# AI Server URL (for PDF download)
VITE_AI_SERVER_URL=http://localhost:8000

