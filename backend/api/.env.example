# Claude API Key (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# 멀티태스크 모델 (기본: random_split → {dog|cat}_best_random_split.pth)
MODEL_VERSION=random_split
MODEL_CHECKPOINT_DIR=models/classifier/checkpoints
# MODEL_CHECKPOINT_DOG=
# MODEL_CHECKPOINT_CAT=

# 추론 백엔드: pytorch | onnx | onnx_int8
INFERENCE_BACKEND=onnx_int8
# ORT_PROVIDERS=CPUExecutionProvider

# 보안 (선택)
# AI_INTERNAL_TOKEN: 설정 시 /api/ai/* 는 X-Internal-Token 헤더가 일치해야 함 (백엔드와 같은 값).
#   Docker Compose 에서는 backend/.env 에 한 번만 두면 ai 컨테이너에도 주입됩니다.
# AI_INTERNAL_TOKEN=change-me-random-string
# AI_CORS_ORIGINS: 브라우저 직접 호출이 필요할 때만 (기본: 비움 = 허용 origin 없음, '*' 불가)
# AI_CORS_ORIGINS=http://localhost:5173

# Optional: AWS S3 설정
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-northeast-2
